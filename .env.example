# -------------------------
# Ports (Host)
# -------------------------
DB_PORT=5432

# API: exposed on the host (for local debugging)
API_PORT_HOST=3000
# API: internal container port
API_PORT_INTERNAL=3000

# Caddy: public ports
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Caddy site address
# Local development:
# CADDY_SITE_ADDRESS=:80
# Server with domain (automatic TLS):
# CADDY_SITE_ADDRESS=sync.example.org
CADDY_SITE_ADDRESS=:80

API_REPLICAS=4

# Caddy upstream to the API service (Docker network)
API_UPSTREAM=api:3000

# -------------------------
# PostgreSQL
# -------------------------
POSTGRES_DB=syncvault
POSTGRES_USER=syncvault
POSTGRES_PASSWORD=syncvault_dev_password

# Internal database URL (Docker network: hostname "db", port 5432)
DATABASE_URL=postgres://syncvault:syncvault_dev_password@db:5432/syncvault

# -------------------------
# API / Authorization
# -------------------------

# JWT signing secret (server-side only)
# MUST be a long, random value in production
JWT_SECRET=please_change_me_to_a_long_random_secret

# JWT configuration (sync authorization)
JWT_TTL_SECONDS=15552000            # 180 days
JWT_ISSUER=medical-sync-vault
JWT_AUDIENCE=sync-vault

# App-level protection for pre-auth bootstrap and token-issue endpoints
# Sent by the mobile app via the X-App-Token header
# This is NOT a user secret, but a basic abuse-protection mechanism
APP_ISSUE_TOKEN=change_me_long_random_string

# Admin-only bearer token for operational aggregate statistics.
# Never ship this in the mobile app.
ADMIN_STATS_TOKEN=change_me_long_random_admin_stats_token

# Runtime bundle-cipher material for QR/clipboard secret transfer.
# Use the old EXPO_PUBLIC_BUNDLE_CIPHER_KEY value as CURRENT_SECRET during rollout
# if you need compatibility with bundles created by older app builds.
BUNDLE_CIPHER_CURRENT_KID=2026-03-13
BUNDLE_CIPHER_CURRENT_SECRET=change_me_long_random_bundle_cipher_secret
# Optional previous key kept for short overlap during rotation.
BUNDLE_CIPHER_PREVIOUS_KID=
BUNDLE_CIPHER_PREVIOUS_SECRET=

# -------------------------
# Limits
# -------------------------
MAX_BATCH_EVENTS=500
MAX_PULL_LIMIT=2000

# -------------------------
# Backups
# -------------------------

# Production: start Compose with the backup profile enabled.
# Example: COMPOSE_PROFILES=backup docker compose up -d --build
COMPOSE_PROFILES=

# Restic repository on Hetzner Object Storage.
# Format: s3:https://<location>.your-objectstorage.com/<bucket>/<optional-prefix>
# Examples:
# BACKUP_RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/tenos-sync-vault-backups/prod
# BACKUP_RESTIC_REPOSITORY=s3:https://nbg1.your-objectstorage.com/tenos-sync-vault-backups/prod
# BACKUP_RESTIC_REPOSITORY=s3:https://hel1.your-objectstorage.com/tenos-sync-vault-backups/prod
BACKUP_RESTIC_REPOSITORY=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Restic encrypts backup objects before upload. Store this password outside Git.
BACKUP_RESTIC_PASSWORD=change_me_long_random_backup_encryption_password

# Backup schedule and retention.
# Default interval: 6 hours.
BACKUP_DATABASE_NAME=syncvault
BACKUP_RESTIC_HOSTNAME=sync-vault
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RUN_ON_START=true
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=3

# Set to true for smaller installations if you want restic check after every backup.
# For larger repositories, run backup-check.sh manually or on a separate schedule.
BACKUP_RUN_CHECK_AFTER_BACKUP=false
